# LumeHub 生产环境变量（可复制到 Supervisor「环境变量」或 shell）
# 完整说明见 Backend/README.md

# 监听地址（宝塔需在「安全」中放行对应端口）
LUMEHUB_ADDR=:5353

# 数据与静态目录（一般保持默认，无需修改）
# LUMEHUB_DATA=./data
# LUMEHUB_WWW=./www

# 仅当前面有 HTTPS 反代时设为 1；直连 HTTP 请留空或删除
# LUMEHUB_COOKIE_SECURE=1

# 会话有效小时数（默认由程序内置）
# LUMEHUB_SESSION_HOURS=168

# 单口令兼容（已使用 accounts.json 多账号时可省略）
# LUMEHUB_PASSWORD=

# 关闭启动横幅 ANSI 颜色
# LUMEHUB_NO_COLOR=1
