# 复制为 deploy.env 后填写（deploy.env 已被 git 忽略，勿提交密钥）
# 用于 scripts/deploy.ps1 上传构建产物到 Linux 服务器

# SSH 目标，格式 user@host 或 user@host:port（port 也可单独写在 SSH_PORT）
DEPLOY_TARGET=root@192.168.1.100

# 可选：SSH 端口，默认 22
# SSH_PORT=22

# 服务器上的 LumeHub 根目录（需已存在，且含 data/）
REMOTE_PATH=/www/wwwroot/lumehub

# 可选：私钥路径（留空则使用 ssh-agent / 默认密钥）
# SSH_KEY=C:\Users\你\.ssh\id_ed25519

# 可选：上传后在服务器执行的命令（如 Supervisor 重启）
# REMOTE_POST_CMD=supervisorctl restart lumehub
